{
  "name": "sdp-township-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/build-planning-worker.mjs && node scripts/build-map-area.mjs",
    "dev": "next dev",
    "predev:local": "node scripts/build-planning-worker.mjs && node scripts/build-map-area.mjs",
    "dev:local": "npm run db:up && npm run db:setup && next dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:setup": "node scripts/database.mjs setup",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "data:refresh": "node scripts/refresh-pilot.mjs",
    "data:rebuild": "node scripts/refresh-pilot.mjs --offline --osm-file data/pasar-seni/source/pasar-seni-osm.json.gz --population-file data/pasar-seni/source/population_district.csv.gz",
    "data:refresh:um": "node scripts/refresh-um-campus.mjs",
    "data:details": "node scripts/refresh-walking-details.mjs",
    "data:rebuild:um": "node scripts/refresh-um-campus.mjs --osm-file data/um-campus/source/um-campus-osm.json.gz",
    "gis:export": "node scripts/export-gis.mjs",
    "build": "node scripts/build-planning-worker.mjs && node scripts/build-map-area.mjs && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/*.integration.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "geist": "^1.9.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "5.10.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "^10.4.5",
    "braces": "^3.0.3"
  }
}
